NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Private /status access. Production fails closed when neither allowlist is set.
# Use comma-separated values; email matching is case-insensitive.
STATUS_PAGE_ALLOWED_EMAILS=owner@example.com
# STATUS_PAGE_ALLOWED_USER_IDS=00000000-0000-0000-0000-000000000000

# Optional read-only Supabase platform access for Realtime health and the
# redacted one-hour error feed. The project ref is derived from the public URL
# when possible. Prefer a fine-grained token with project and analytics reads.
# SUPABASE_PROJECT_REF=your-project-ref
# SUPABASE_MANAGEMENT_TOKEN=replace-with-a-read-only-token

# Optional Vercel deployment history. VERCEL_PROJECT_ID and VERCEL_TEAM_ID are
# supplied automatically on Vercel; set them locally when testing the API.
# VERCEL_ACCESS_TOKEN=replace-with-a-read-only-token
# VERCEL_PROJECT_ID=prj_example
# VERCEL_TEAM_ID=team_example
# VERCEL_TEAM_SLUG=your-team
# VERCEL_PROJECT_NAME=dispatch-desk

# Full /api endpoint for a self-hosted Photon geocoder. Required in production;
# local development has a low-volume demo fallback. This value stays server-side.
# See docs/photon-geocoding.md for installation and production guidance.
# PHOTON_API_URL=http://127.0.0.1:2322/api

# Optional production error-monitoring webhook. Server errors are always logged
# as structured JSON; when set, sanitized error events are also posted here.
# ERROR_MONITORING_WEBHOOK_URL=https://monitoring.example.com/events
# ERROR_MONITORING_WEBHOOK_TOKEN=replace-with-a-secret-token
# APP_RELEASE=production-release-id
